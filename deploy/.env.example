# Sovereign Router v0.5 — environment template (PLACEHOLDERS ONLY)
#
# Copy to ".env" ON VM103 ONLY, fill in the non-secret values there.
# This example file, and any filled copy, must NEVER contain a real
# provider key, client key, key hash, password, or token. Real keys live
# only as individual mode-600 files in the secrets directory (below).
# Never commit a filled .env, never put it in Drive, never paste it in chat.

# Environment label for this deployment (v05 = the v0.5 stack; production
# v0.2.1 and the v0.3.3 canary keep their own separate environments/keys).
SOVEREIGN_ENV=v05

# Host paths on VM103 (operator fills in the real paths at deploy time).
STATE_DIR=/root/sovereign-router-v05/state
SECRETS_DIR=/root/sovereign-router-v05/secrets
MODELS_DIR=/root/sovereign-router-v05/models

# Internal container ports (NOT host-published; the only host-published
# port in the stack is nginx on 192.168.0.166:6075).
GATEWAY_INTERNAL_PORT=6075
CLASSIFIER_INTERNAL_PORT=8080

# Classifier timeout in the request path, milliseconds (spec: 1.5 s max,
# then the gateway falls back to the rules layer and logs it).
CLASSIFIER_TIMEOUT_MS=1500

# --- Secrets: file names only, never values ---
# Create one mode-600 file per key inside SECRETS_DIR on VM103, e.g.:
#   groq.key  ollama.key  openrouter.key  deepinfra.key
#   anthropic.key  openai.key  gemini.key        (premium lane, if kept)
#   clients.txt                                   (sha256 hashes only —
#                                                  see clients.example.txt)
#   admin.key                                     (admin endpoints only)
# Example creation pattern (run on VM103, value typed at the prompt there,
# never in this file):
#   install -m 600 /dev/null "$SECRETS_DIR/groq.key"   # then edit in place
# Verify before deploy:  stat -c '%a %n' "$SECRETS_DIR"/*   # all must be 600

# --- Owner decisions, accepted 2026-11-01 (deploy/DECISIONS.md) ---
# Emergency level: $25/day across paid lanes. WARN-ONLY by default (owner
# ruling 2026-11-09); set WARN_ONLY=0 only to deliberately arm the hard switch.
SOVEREIGN_EMERGENCY_SWITCH=1
SOVEREIGN_EMERGENCY_DAILY_USD=25
# v0.5.7 warn-only (owner ruling 2026-11-09): alert at the level above,
# never switch the paid lanes off. Default 1; 0 arms the hard switch.
SOVEREIGN_EMERGENCY_WARN_ONLY=1
