  {
   "id": "extract-new-alerts",
   "name": "Extract New Alerts",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const s = $getWorkflowStaticData('global');\nconst resp = $input.first().json;\nconst alerts = resp.alerts || [];\nconst lastId = (resp.last_id !== undefined) ? resp.last_id : s.last_alert_id;\nconst now = Date.now();\nif (s.last_poll_ok_ts) {\n  const gapMin = Math.round((now - s.last_poll_ok_ts) / 60000);\n  if (!s.worst_gap_minutes || gapMin > s.worst_gap_minutes) s.worst_gap_minutes = gapMin;\n}\ns.last_poll_ok_ts = now;\ns.consecutive_poll_failures = 0;\nconst fmt = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Denver', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });\nconst lines = [];\nlet headline = '';\nif (alerts.length > 0) {\n  headline = alerts.length + ' new alert' + (alerts.length > 1 ? 's' : '');\n  lines.push('\\u26a0\\ufe0f Sovereign Router \\u2014 ' + headline);\n  for (const a of alerts) lines.push('\\u2022 [' + a.kind + '] ' + a.message + (a.scope ? ' (' + a.scope + ')' : ''));\n}\nif (s.chain_broken && s.degraded_since_ts) {\n  const gapMin = Math.max(1, Math.round((now - s.degraded_since_ts) / 60000));\n  lines.push('Alert chain recovered \\u2014 gap of ' + gapMin + ' minutes (router flagged degraded in /health)');\n  if (!headline) headline = 'alert chain recovered';\n}\nif (lines.length === 0) { s.last_alert_id = lastId; return []; }\nlines.push('Since: ' + fmt.format(new Date()) + ' MT \\u00b7 /admin/costs poll OK');\ns.pending_last_id = lastId;\nreturn [{ json: { message: lines.join('\\n'), headline: headline, count: alerts.length } }];"
   }
  },
