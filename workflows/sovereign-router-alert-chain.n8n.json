  {
   "id": "format-all-clear",
   "name": "Format All-Clear",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    900
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const s = $getWorkflowStaticData('global');\nconst r = $input.first().json;\nconst t = r.today || {}, m = r.month || {};\nconst f = (n) => '$' + (Math.round((n || 0) * 100) / 100).toFixed(2);\nconst grp = (arr) => (arr && arr.length) ? arr.map(x => x.key + ' ' + f(x.cost_usd)).join(' \\u00b7 ') : '\\u2014';\nconst lv = (t.by_level && t.by_level.length) ? t.by_level.map(x => 'L' + x.key + ' ' + x.requests).join(' \\u00b7 ') : '\\u2014';\nconst alerts = r.alerts || [];\nconst kinds = alerts.map(a => a.kind).join(', ');\nconst dateStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Denver' }).format(new Date());\nconst lines = [];\nlines.push('\\u2705 Sovereign Router \\u2014 daily all-clear (' + dateStr + ')');\nlines.push('Spend today so far: ' + grp(t.by_client) + ' (total ' + f(t.total_cost_usd) + ')');\nlines.push('Spend month to date: ' + f(m.total_cost_usd));\nlines.push('By provider (today): ' + grp(t.by_provider));\nlines.push('Free share (today): ' + Math.round((t.free_share || 0) * 100) + '%');\nlines.push('Levels (today, requests): ' + lv);\nlines.push('Alerts raised today: ' + alerts.length + (kinds ? ' (' + kinds + ')' : ''));\nlines.push('Alert chain: ' + (s.chain_broken ? 'BROKEN' : 'polls OK') + ', worst gap ' + (s.worst_gap_minutes || 15) + ' min');\nreturn [{ json: { message: lines.join('\\n'), headline: 'daily all-clear' } }];"
   }
